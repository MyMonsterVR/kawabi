CREATE TABLE animes (
    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    source TEXT NOT NULL,
    key TEXT NOT NULL,
    url TEXT NOT NULL,
    title TEXT NOT NULL,
    author TEXT,
    description TEXT,
    genre TEXT AS kotlin.collections.List<kotlin.String>,
    status TEXT NOT NULL DEFAULT '',
    thumbnail_url TEXT,
    favorite INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    last_update INTEGER,
    next_update INTEGER,
    initialized INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    date_added INTEGER NOT NULL DEFAULT 0,
    calculate_interval INTEGER NOT NULL DEFAULT 0,
    last_modified_at INTEGER NOT NULL DEFAULT 0,
    version INTEGER NOT NULL DEFAULT 0,
    is_syncing INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    total_episodes REAL NOT NULL DEFAULT 0,
    last_watched_at INTEGER NOT NULL DEFAULT 0
);

-- Identity is the backend contract's anime_key ("<engineSourceId>:<relativeUrl>"), not
-- (source, url) like mangas: the source id is already the first half of the key, so the
-- key alone is unique and is what every /anime/* route and sync row is addressed by.
CREATE UNIQUE INDEX animes_key_idx ON animes(key);
CREATE INDEX animes_favorite_idx ON animes(favorite) WHERE favorite = 1;

CREATE TRIGGER update_last_modified_at_animes
AFTER UPDATE ON animes
FOR EACH ROW
WHEN new.last_modified_at == old.last_modified_at AND new.is_syncing = 0
BEGIN
    UPDATE animes SET last_modified_at = (CAST(strftime('%s', 'now') AS INTEGER) * 1000) WHERE _id = new._id;
END;

CREATE TRIGGER update_anime_version
AFTER UPDATE ON animes
FOR EACH ROW
WHEN new.version == old.version AND new.is_syncing = 0
BEGIN
    UPDATE animes SET version = version + 1 WHERE _id = new._id;
END;

insertAnime:
INSERT INTO animes(source, key, url, title, author, description, genre, status, thumbnail_url,
    favorite, last_update, next_update, initialized, date_added, calculate_interval,
    last_modified_at, version, is_syncing, total_episodes, last_watched_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectFavorites:
SELECT * FROM animes WHERE favorite = 1;

-- One row per library anime with everything the Anime tab's three panes need: the
-- episode tallies, the next unwatched episode number, the newest episode's upload date
-- and the linked tracker's status. Derived in SQL rather than per-anime lookups so
-- opening the tab is a single query no matter how large the library is.
-- track_status picks the most recently updated tracker row when an anime is linked to
-- several (MAL + Kitsu + AniList): they can legitimately disagree, and the freshest edit
-- is the closest thing to the user's current intent.
selectLibraryEntries:
SELECT animes.*,
    (SELECT COUNT(*) FROM episodes WHERE episodes.anime_id = animes._id) AS episode_count,
    (SELECT COUNT(*) FROM episodes WHERE episodes.anime_id = animes._id AND episodes.watched = 1) AS watched_count,
    (SELECT MIN(episodes.episode_number) FROM episodes
        WHERE episodes.anime_id = animes._id AND episodes.watched = 0 AND episodes.episode_number != -1) AS next_unwatched_number,
    (SELECT MAX(episodes.episode_number) FROM episodes
        WHERE episodes.anime_id = animes._id AND episodes.watched = 1) AS last_watched_episode,
    (SELECT MAX(episodes.date_upload) FROM episodes WHERE episodes.anime_id = animes._id) AS latest_episode_at,
    (SELECT anime_tracks.status FROM anime_tracks
        WHERE anime_tracks.anime_id = animes._id ORDER BY anime_tracks.updated_at DESC LIMIT 1) AS track_status
FROM animes
WHERE animes.favorite = 1;

selectAnimeById:
SELECT * FROM animes WHERE _id = ?;

selectByKey:
SELECT * FROM animes WHERE key = ? LIMIT 1;

updateFavorite:
UPDATE animes SET favorite = ? WHERE _id = ?;

updateTotalEpisodes:
UPDATE animes SET total_episodes = ? WHERE _id = ?;

-- Metadata that legitimately drifts over time from the source -- excludes local-only
-- state (favorite, dates) which upsert must not clobber, same split as Mangas.sq.
-- An empty/absent incoming cover leaves the stored one alone: the engine's details page
-- often has no thumbnail while the search/browse card for the same key does.
updateMetadata:
UPDATE animes SET source = :source, url = :url, title = :title, author = :author,
    description = :description, genre = :genre, status = :status,
    thumbnail_url = CASE WHEN :thumbnail_url IS NULL OR :thumbnail_url = '' THEN thumbnail_url ELSE :thumbnail_url END
WHERE _id = :id;

fillMissingThumbnail:
UPDATE animes SET thumbnail_url = :thumbnail_url
WHERE _id = :id AND (thumbnail_url IS NULL OR thumbnail_url = '');

setAnimeSyncing:
UPDATE animes SET is_syncing = ? WHERE _id = ?;

-- Monotonic-max, same rule as Mangas.sq's touchLastRead.
touchLastWatched:
UPDATE animes SET last_watched_at = MAX(last_watched_at, ?) WHERE _id = ?;

updateUpdateSchedule:
UPDATE animes SET last_update = ?, next_update = ?, calculate_interval = ? WHERE _id = ?;

selectDueForUpdate:
SELECT * FROM animes WHERE favorite = 1 AND (next_update IS NULL OR next_update <= ?);

lastInsertAnimeRowId:
SELECT last_insert_rowid();
