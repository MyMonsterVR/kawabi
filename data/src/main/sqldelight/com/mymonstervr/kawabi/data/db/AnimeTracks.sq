CREATE TABLE anime_tracks (
    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    anime_id INTEGER NOT NULL,
    tracker_id TEXT NOT NULL,
    remote_id TEXT NOT NULL,
    library_id TEXT,
    title TEXT NOT NULL,
    tracking_url TEXT NOT NULL,
    total_episodes REAL NOT NULL DEFAULT 0,
    last_episode_watched REAL NOT NULL DEFAULT 0,
    score REAL NOT NULL DEFAULT 0,
    status TEXT NOT NULL DEFAULT 'watching',
    FOREIGN KEY(anime_id) REFERENCES animes(_id) ON DELETE CASCADE
);

CREATE UNIQUE INDEX anime_tracks_anime_tracker_idx ON anime_tracks(anime_id, tracker_id);

-- OR REPLACE for the same reason as Tracks.sq: re-linking an already-linked pair
-- replaces the row instead of erroring on the unique index.
insertAnimeTrack:
INSERT OR REPLACE INTO anime_tracks(anime_id, tracker_id, remote_id, library_id, title,
    tracking_url, total_episodes, last_episode_watched, score, status)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectByAnime:
SELECT * FROM anime_tracks WHERE anime_id = ?;

selectByAnimeAndTracker:
SELECT * FROM anime_tracks WHERE anime_id = ? AND tracker_id = ? LIMIT 1;

deleteByAnimeAndTracker:
DELETE FROM anime_tracks WHERE anime_id = ? AND tracker_id = ?;

-- Monotonic-max, same rule as Tracks.sq's updateChaptersRead.
updateEpisodesWatched:
UPDATE anime_tracks SET last_episode_watched = MAX(last_episode_watched, ?) WHERE _id = ?;

updateTotalEpisodes:
UPDATE anime_tracks SET total_episodes = ? WHERE _id = ?;

-- Explicit user edit -- deliberately NOT monotonic-max, see Tracks.sq's updateTrackDetails.
updateTrackDetails:
UPDATE anime_tracks SET last_episode_watched = ?, status = ?, score = ? WHERE _id = ?;

lastInsertAnimeTrackRowId:
SELECT last_insert_rowid();
